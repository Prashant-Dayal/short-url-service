<!DOCTYPE html>
<html lang="en">
<head>

<style >
body{
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif ;
}

</style>   
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home page</title>
</head>
<body>  
    <h1>URL Shortener</h1>
    <% if (locals.id) { %>
        <p>Your short URL is: http://localhost:3000/<%= id %></a></p>
     
    <% } %>
    <diV>
        <form method="POST" action="/url">
            <label>Enter your Original URL:</label>
            <input type="text" name="url" required placeholder="Enter your URL here">
             <button type="submit">Generate Short URL</button>
        </form>
      
    </diV>
    <% if (locals.urls) { %>
     <table>
        <thead>
            <tr>
                <th>S.No</th>
                <th>ShortID</th>
                <th>Redirect</th>
                <th>Clicks</th>
            </tr>
        </thead>
        <tbody>
            <% urls.forEach((url, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= url.shortID %></td>
                    <td><%= url.redirectUrl %></td>
                    <td><%= url.visitsHistory.length %></td>
                </tr>
            <% }); %>
        </tbody>
     </table>
    <% } %>

   
</body>
</html>